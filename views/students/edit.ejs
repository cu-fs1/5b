<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Student</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f5f5f5; color: #333; padding: 2rem; }
    h1 { margin-bottom: 1.5rem; }
    form { display: flex; flex-direction: column; gap: 0.75rem; max-width: 320px; }
    label { font-size: 0.9rem; font-weight: 600; }
    input { padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
    .actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
    button { padding: 0.5rem 1rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; }
    .btn-save   { background: #4caf50; color: #fff; }
    .btn-cancel { background: #9e9e9e; color: #fff; text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; font-size: 1rem; }
  </style>
</head>
<body>

  <h1>Edit Student</h1>

  <form action="/view/students/<%= student._id %>?_method=PUT" method="POST">
    <label>Name</label>
    <input type="text"   name="name" value="<%= student.name %>" required />
    <label>Roll</label>
    <input type="number" name="roll" value="<%= student.roll %>" required />
    <div class="actions">
      <button type="submit" class="btn-save">Save</button>
      <a href="/view/students" class="btn-cancel">Cancel</a>
    </div>
  </form>

</body>
</html>
